# Copy to .env beside compose.yaml. Every value here has a default except the
# two media paths.

# Folders on the host, mounted read-only at /media/Movies and /media/TV.
VCRX_MOVIES_DIR=/path/to/media/Movies
VCRX_TV_DIR=/path/to/media/TV

# Where the database (config) and caches live on the host.
VCRX_DATA_DIR=./data

# Listen address and port. Keep it on the LAN: never forward this port on a router.
VCRX_BIND=0.0.0.0
VCRX_PORT=3750

VCRX_SERVER_NAME=VCRX
VCRX_LOG_LEVEL=info
# Concurrent ffprobe runs during a scan. Keep it low on a network share.
VCRX_PROBE_CONCURRENCY=4
# Video transcodes at once, for browsers that cannot decode a file's video.
# Each takes one or more CPU cores; 0 turns video transcoding off.
VCRX_MAX_TRANSCODES=2

# Optional: your own TMDb API key or API Read Access Token, for posters, plots,
# cast and episode stills. Leave empty to keep VCRX fully offline.
VCRX_TMDB_API_KEY=
#VCRX_TMDB_LANGUAGE=en-US
#VCRX_TMDB_COUNTRY=US
# Home rows from TMDb's trending and popular lists, limited to your library.
#VCRX_TMDB_HOME_LISTS=false

# Optional: subtitle search on OpenSubtitles (opensubtitles.com, a free account
# and an API consumer key from its API page). The key alone turns on search;
# downloads also need the account, whose daily quota (20 on a free account) the
# whole server shares. Leave empty to keep subtitle search off.
#VCRX_OPENSUBTITLES_API_KEY=
#VCRX_OPENSUBTITLES_USERNAME=
#VCRX_OPENSUBTITLES_PASSWORD=
# Languages searched by default and fetched automatically, comma separated.
#VCRX_SUBTITLE_LANGUAGES=en
# Fetch those languages for files added from now on that have none, once each.
#VCRX_SUBTITLE_AUTO_FETCH=false

# Optional: webhooks for play, stop, refused and terminated events, comma
# separated. A Discord webhook URL gets a plain Discord message.
#VCRX_WEBHOOK_URLS=https://discord.com/api/webhooks/<id>/<token>

# Optional: lets Radarr and Sonarr tell VCRX about imports (Settings, Connect,
# Webhook). At least 16 characters; make one with: openssl rand -hex 16
#VCRX_ARR_WEBHOOK_TOKEN=

# The user the container runs as; it must be able to read the media folders and
# write VCRX_DATA_DIR.
VCRX_UID=1000
VCRX_GID=1000
TZ=UTC
