# Copy to caddy.env (gitignored, chmod 600) and fill in. Never commit caddy.env.
VCRX_DOMAIN=watch.example.com
# This host's LAN address: the router forwards public 443 here.
CADDY_BIND=192.168.0.20
HTTPS_PORT=3752
ACME_EMAIL=you@example.com
# Cloudflare API token, permissions Zone > DNS > Edit, zone resources limited
# to the one zone that holds VCRX_DOMAIN. Nothing else.
CF_API_TOKEN=replace-me
